{
  "name": "local-skill-exchange",
  "version": "1.0.0",
  "description": "Neighbourhood time-banking skill exchange platform built with the MERN stack.",
  "scripts": {
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build:backend": "echo \"Backend ready\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "seed": "npm run seed --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
